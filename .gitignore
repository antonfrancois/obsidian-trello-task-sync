# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# test vault: Obsidian's per-session state
test-vault/.obsidian/workspace*.json
test-vault/.obsidian/plugins/*/data.json
# plugin copies written into the test vault by each build, and the Hot Reload plugin
test-vault/.obsidian/plugins/trello-task-sync/*.js
test-vault/.obsidian/plugins/trello-task-sync/*.json
test-vault/.obsidian/plugins/trello-task-sync/*.css
test-vault/.obsidian/plugins/hot-reload/

# design notes, kept local (not published)
PLAN-*.md
